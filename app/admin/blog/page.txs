'use client';

import { useState } from 'react';
import { Plus, Trash2 } from 'lucide-react';

export default function BlogAdminPage() {
  const [title, setTitle] = useState('');
  const [posts, setPosts] = useState([
    {
      id: 1,
      title: 'How to Download Instagram Reels',
      date: '2026-05-21',
    },
  ]);

  const addPost = () => {
    if (!title.trim()) return;

    setPosts([
      {
        id: Date.now(),
        title,
        date: new Date().toISOString().split('T')[0],
      },
      ...posts,
    ]);

    setTitle('');
  };

  const deletePost = (id: number) => {
    setPosts(posts.filter((post) => post.id !== id));
  };

  return (
    <div>
      <h1 className="text-3xl font-bold">Blog Manager</h1>
      <p className="text-gray-400 mt-1">Create SEO blog posts.</p>

      <div className="mt-8 bg-white/5 border border-white/10 rounded-2xl p-5">
        <h2 className="text-xl font-semibold mb-4">Add Blog Post</h2>

        <div className="flex flex-col md:flex-row gap-3">
          <input
            value={title}
            onChange={(e) => setTitle(e.target.value)}
            placeholder="Blog title"
            className="flex-1 bg-black/40 border border-white/10 rounded-xl px-4 py-3 outline-none focus:border-red-500"
          />

          <button
            onClick={addPost}
            className="bg-red-600 hover:bg-red-700 px-5 py-3 rounded-xl flex items-center justify-center gap-2"
          >
            <Plus size={18} />
            Add
          </button>
        </div>
      </div>

      <div className="grid gap-4 mt-6">
        {posts.map((post) => (
          <div
            key={post.id}
            className="bg-white/5 border border-white/10 rounded-2xl p-5 flex justify-between items-center"
          >
            <div>
              <h2 className="font-semibold">{post.title}</h2>
              <p className="text-gray-500 text-sm">{post.date}</p>
            </div>

            <button
              onClick={() => deletePost(post.id)}
              className="text-red-400 hover:text-red-500"
            >
              <Trash2 size={20} />
            </button>
          </div>
        ))}
      </div>
    </div>
  );
}