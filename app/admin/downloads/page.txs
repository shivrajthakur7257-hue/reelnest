'use client';

import { useState } from 'react';

export default function DownloadsPage() {
  const [logs] = useState([
    {
      id: 1,
      platform: 'Instagram',
      url: 'https://instagram.com/reel/example',
      status: 'success',
      date: '2026-05-21',
    },
    {
      id: 2,
      platform: 'YouTube',
      url: 'https://youtube.com/watch?v=demo',
      status: 'failed',
      date: '2026-05-21',
    },
    {
      id: 3,
      platform: 'MP3',
      url: 'https://youtube.com/shorts/demo',
      status: 'success',
      date: '2026-05-20',
    },
  ]);

  return (
    <div>
      <h1 className="text-3xl font-bold">Download Logs</h1>
      <p className="text-gray-400 mt-1">Track all user download requests.</p>

      <div className="mt-8 bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <table className="w-full min-w-[700px]">
          <thead className="bg-white/10">
            <tr>
              <th className="p-4 text-left">Platform</th>
              <th className="p-4 text-left">URL</th>
              <th className="p-4 text-left">Status</th>
              <th className="p-4 text-left">Date</th>
            </tr>
          </thead>

          <tbody>
            {logs.map((log) => (
              <tr key={log.id} className="border-t border-white/10">
                <td className="p-4">{log.platform}</td>
                <td className="p-4 max-w-md truncate">{log.url}</td>
                <td className="p-4">
                  <span
                    className={
                      log.status === 'success' ? 'text-green-400' : 'text-red-400'
                    }
                  >
                    {log.status}
                  </span>
                </td>
                <td className="p-4">{log.date}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}